   "source": [
    "# Step 0 from the plan: the ORACLE -- the best possible single round trip per session.\n",
    "# THIS IS A LABEL, NOT A FEATURE. It uses the whole session and lives in its own frame so\n",
    "# it cannot leak into df_min by accident.\n",
    "COST_BPS, DEGRADE = 3.0, 5\n",
    "df_oracle = rs.build_oracle(df_min, cost_bps=COST_BPS, degrade=DEGRADE)\n",
    "\n",
    "pd.set_option(\"display.width\", 200)\n",
    "print(f\"ORACLE -- best single round trip per session, {ticker}\\n\")\n",
    "print(df_oracle[[\n",
    "    \"index_day\", \"date\", \"best_side\", \"long_entry_min\", \"long_exit_min\",\n",
    "    \"long_entry_price\", \"long_exit_price\", \"long_pct\", \"short_pct\",\n",
    "    \"hold_minutes\", \"day_range_pct\", \"ceiling_pct\", \"degraded_pct\",\n",
    "]].to_string(index=False))\n",
    "\n",
    "n = len(df_oracle)\n",
    "print(f\"\\n--- the three questions from the plan ({n} sessions) ---\")\n",
    "print(f\"1. median oracle long, net of {COST_BPS:.0f}bps : \"\n",
    "      f\"{df_oracle['long_pct_net'].median():.3f}%   \"\n",
    "      f\"(gross {df_oracle['long_pct'].median():.3f}%, \"\n",
    "      f\"cost is {COST_BPS / 100 / df_oracle['long_pct'].median() * 100:.1f}% of it)\")\n",
    "print(f\"   median day range                     : {df_oracle['day_range_pct'].median():.3f}%\")\n",
    "print(f\"   oracle captures                      : \"\n",
    "      f\"{(df_oracle['long_pct'] / df_oracle['day_range_pct']).median() * 100:.0f}% of the range\")\n",
    "keep = (df_oracle[\"degraded_pct\"] / df_oracle[\"long_pct\"]).median() * 100\n",
    "print(f\"2. giving up {DEGRADE}min at each end keeps    : {keep:.0f}% of the oracle profit\")\n",
    "print(f\"   -> {'timing is forgiving' if keep > 60 else 'EDGE NEEDS PRECISION WE WONT HAVE'}\")\n",
    "top = max(1, round(0.2 * n))\n",
    "share = df_oracle[\"best_pct\"].nlargest(top).sum() / df_oracle[\"best_pct\"].sum() * 100\n",
    "print(f\"3. top {top} of {n} sessions hold            : {share:.0f}% of total oracle profit\")\n",
    "print(f\"   -> {'day SELECTION matters more than intraday timing' if share > 40 else 'profit is spread evenly across days'}\")\n",
    "print(f\"\\nNOTE: {n} sessions is far too few to conclude anything. The plan calls for \"\n",
    "      f\"years, and\\n      more symbols before more history.\")\n"
   ]
