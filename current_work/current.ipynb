    "%load_ext autoreload\n",
    "%autoreload 2\n",
    "\n",
    "import matplotlib.pyplot as plt\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "from massive import RESTClient\n",
    "\n",
    "import plots\n",
    "import research as rs\n",
    "from research import DAY_START, DAY_END, REG_MINUTES\n",
    "\n",
    "API_KEY = '"api_key"'\n",
    "\n",
    "ticker = \"AAPL\"\n",
    "date_from = \"2023-06-05\"\n",
    "date_to = \"2023-06-10\"\n",
    "stats_window = 60          # minutes in the running window; also where cumulative starts\n",
    "\n",
    "client = RESTClient(api_key=API_KEY)\n",
    "aggs = []\n",
    "for a in client.list_aggs(ticker=ticker, multiplier=1, timespan=\"second\",\n",
    "                          from_=date_from, to=date_to, limit=50000):\n",
    "    aggs.append(a.__dict__)\n",
    "\n",
    "df_aapl = pd.DataFrame(aggs)\n",
    "df_aapl = rs.add_time_index(df_aapl)   # day, index_day, index_minute (market-local)\n",
    "df_aapl = rs.add_returns(df_aapl)      # open_pct ... vwap_pct, volume_pct\n",
    "\n",
    "print(df_aapl.head())\n",
    "\n",
    "# for the bar-count sanity check in the next cell\n",
    "mins = df_aapl[\"index_minute\"]\n",
    "n_sessions = df_aapl[\"index_day\"].nunique()\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "de33746a",
   "metadata": {},
   "outputs": [],
   "source": [
    "# data-coverage sanity check: one bin per minute, so each column's height is the number\n",
    "# of sessions that had a bar at that minute of the day\n",
    "plots.plot_bar_coverage(df_aapl[\"index_minute\"], ticker=ticker,\n",
    "                        n_sessions=n_sessions, n_bars=len(df_aapl))\n",
    "plt.show()\n",
    "\n",
    "print(mins.describe())\n",
    "print(\"regular-hours bars:\", ((mins >= 0) & (mins < REG_MINUTES)).sum())\n",
    "print(\"premarket bars:    \", (mins < 0).sum())\n",
    "print(\"afterhours bars:   \", (mins >= REG_MINUTES).sum())\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "beb83636",
   "metadata": {},
   "outputs": [],
   "source": [
    "# All stats and indicators. What gets calculated is research.PIPELINE -- edit that list\n",
    "# to add, drop or reorder a group; each function's docstring says what it produces.\n",
    "df_reg, df_min = rs.build_features(df_aapl, window=stats_window)\n",
    "\n",
    "print(\"pipeline:\", [f.__name__ for f in rs.PIPELINE])\n",
    "print(f\"{len(df_reg):,} second-bars -> {len(df_min):,} minutes \"\n",
    "      f\"over {df_min['index_day'].nunique()} sessions\")\n",
    "print(\"second-bars per minute:\",\n",
    "      df_min[\"bars\"].describe()[[\"mean\", \"min\", \"50%\", \"max\"]].to_dict())\n",
    "\n",
    "feats = rs.feature_names(df_min)\n",
    "print(f\"\\n{len(feats)} indicators on {len(df_min):,} minutes\\n\")\n",
    "print(df_min[feats].describe().T[[\"count\", \"mean\", \"std\", \"min\", \"50%\", \"max\"]])\n",
    "print(\"\\nnon-null by session (day 0 is NaN wherever a prior session is required):\")\n",
    "print(df_min.groupby(\"index_day\")[\n",
    "    [\"rv_vol\", \"yz_vol\", \"rvol\", \"or30_break\", \"efficiency_ratio\",\n",
    "     \"prev_d_range_pct\", \"overnight_gap_atr\"]].count())\n",
    "\n",
    "# change day= to look at any other session\n",
    "plots.plot_session_stats(df_min, day=0, ticker=ticker, window=stats_window)\n",
    "plt.show()\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "e066e680",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Jump-diffusion terms from the close % returns, one session per thread.\n",
    "df_min, jump_stats = rs.compute_jump_terms(df_reg, df_min, stats_window, max_threads=8)\n",
    "\n",
    "print(f\"{jump_stats['sessions']} sessions, {jump_stats['windows']:,} windows, \"\n",
    "      f\"{jump_stats['points']:,} path points\")\n",
    "print(f\"wall {jump_stats['wall_s']:.1f}s vs {jump_stats['thread_s']:.1f}s of thread time \"\n",
    "      f\"-> {jump_stats['speedup']:.2f}x \"\n",
    "      f\"({jump_stats['threads_usable']} of {jump_stats['max_threads']} threads usable)\")\n",
    "\n",
    "print(df_min[rs.JUMP_COLS + [\"ret_roll_xi\", \"ret_cum_xi\"]].describe().T)\n",
    "print(\"\\nshare of finite estimates that came out negative (should be ~0 to be usable):\")\n",
    "print(rs.negative_share(df_min))\n",
    "print(\"\\nper-session median running estimates:\")\n",
    "print(df_min.groupby(\"index_day\")[[\"ret_roll_xi\", \"ret_roll_lamb\"]].median())\n",
    "\n",
    "# change day= to look at any other session\n",
    "plots.plot_session_jumps(df_min, day=0, ticker=ticker, window=stats_window)\n",
    "plt.show()\n"
   ]
  },
